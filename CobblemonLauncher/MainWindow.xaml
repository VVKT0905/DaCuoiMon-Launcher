<Window x:Class="CobblemonLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Đá Cuội Mon"
        Height="470" Width="510"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI, -apple-system, BlinkMacSystemFont, Arial"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Apple Liquid Glass Shadow -->
        <DropShadowEffect x:Key="LiquidGlassShadow" Color="#000000" BlurRadius="35" ShadowDepth="8" Opacity="0.75" Direction="270"/>
        <!-- Apple Emerald Liquid Glow -->
        <DropShadowEffect x:Key="EmeraldLiquidGlow" Color="#00FF9D" BlurRadius="24" ShadowDepth="2" Opacity="0.85" Direction="270"/>

        <!-- Apple Glass TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="CaretBrush" Value="#00FF9D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="16" Margin="0">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#45FFFFFF" Offset="0.0"/>
                                    <GradientStop Color="#15FFFFFF" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="12,8"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#25FFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#00FF9D"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimalist Window Close Button -->
        <Style x:Key="AppleCloseBtn" TargetType="Button">
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="Foreground" Value="#B0C4DE"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF453A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Apple Dark Glass Button -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="10,6">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#40FFFFFF" Offset="0.0"/>
                                    <GradientStop Color="#15FFFFFF" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#30FFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#8000FF9D"/>
                                <Setter Property="Foreground" Value="#00FF9D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#15FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Minimalist ScrollBar (Slim 6px Apple Pill Slider) -->
        <Style x:Key="AppleScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder" CornerRadius="3" Background="#40FFFFFF" Margin="1,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#8000FF9D"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="true">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#00FF9D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource AppleScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Apple Dark Liquid ComboBoxItem Style -->
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}" Margin="4,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#25FFFFFF"/>
                                <Setter Property="Foreground" Value="#00FF9D"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3000FF9D"/>
                                <Setter Property="Foreground" Value="#00FF9D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox ToggleButton Template -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="{x:Type ToggleButton}">
            <Border x:Name="Border" CornerRadius="12" Background="#1AFFFFFF" BorderThickness="1">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#40FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#15FFFFFF" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Fill="#A0AEC0" Data="M 0 0 L 4 4 L 8 0 Z" Margin="0,1,6,0"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter TargetName="Border" Property="Background" Value="#25FFFFFF"/>
                    <Setter TargetName="Border" Property="BorderBrush" Value="#8000FF9D"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="true">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#00FF9D"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Apple Dark Liquid ComboBox Style -->
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Template="{StaticResource ComboBoxToggleButtonTemplate}"
                                          Focusable="false" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="false"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,0,28,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="true" Focusable="false" PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="true" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="220" Margin="0,4,0,0">
                                    <Border x:Name="DropDownBorder" Background="#F00D1117" CornerRadius="12" BorderThickness="1.2"
                                            Effect="{StaticResource LiquidGlassShadow}" Padding="4">
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#60FFFFFF" Offset="0.0"/>
                                                <GradientStop Color="#15FFFFFF" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                        <ScrollViewer SnapsToDevicePixels="true">
                                            <StackPanel IsItemsHost="true" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Canvas with margin for protruding mascot & soft shadow -->
    <Grid Margin="12,16,12,14">
        <!-- APPLE LIQUID GLASS CARD (Rounded black translucent card, NO square corner leak) -->
        <Border Margin="0,32,0,0" CornerRadius="28" BorderThickness="1.2"
                Background="#F0080B10" Effect="{StaticResource LiquidGlassShadow}">
            <!-- Specular Rim Border -->
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#85FFFFFF" Offset="0.0"/>
                    <GradientStop Color="#25FFFFFF" Offset="0.35"/>
                    <GradientStop Color="#0DFFFFFF" Offset="0.70"/>
                    <GradientStop Color="#35FFFFFF" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.BorderBrush>

            <!-- Card Interior Grid with perfect rounded corner clipping -->
            <Grid MouseLeftButtonDown="Window_MouseDown" SizeChanged="CardGrid_SizeChanged">
                <Grid.Clip>
                    <RectangleGeometry x:Name="CardClipGeometry" Rect="0,0,486,408" RadiusX="28" RadiusY="28"/>
                </Grid.Clip>

                <!-- Subtle Top Caustic Glint with matching rounded corner -->
                <Border CornerRadius="28,28,0,0" VerticalAlignment="Top" Height="140">
                    <Border.Background>
                        <RadialGradientBrush Center="0.5,-0.2" GradientOrigin="0.5,-0.2" RadiusX="0.8" RadiusY="0.6">
                            <GradientStop Color="#22FFFFFF" Offset="0.0"/>
                            <GradientStop Color="#0600FF9D" Offset="0.6"/>
                            <GradientStop Color="#00000000" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Top Edge Light Glint (Pure Specular Rim) -->
                <Border VerticalAlignment="Top" Height="1" Margin="32,0,32,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00FFFFFF" Offset="0.0"/>
                            <GradientStop Color="#A0FFFFFF" Offset="0.5"/>
                            <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Apple Minimalist Close Button (Top Right) -->
                <Button x:Name="BtnLauncherClose" Content="✕" Style="{StaticResource AppleCloseBtn}" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Margin="0,14,16,0" Click="BtnClose_Click"/>

                <!-- MAIN INTERACTION AREA -->
                <Grid Margin="24,42,24,22">
                    <!-- ============================================== -->
                    <!-- 1. PRE-LAUNCH PANEL (Initial State)            -->
                    <!-- ============================================== -->
                    <Grid x:Name="PanelPreLaunch" Visibility="Visible" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center" Width="300">
                            <!-- Player Name Input (Apple Liquid Capsule) -->
                            <TextBlock Text="TÊN NHÂN VẬT" FontSize="11" FontWeight="Bold" Foreground="#8FA0B4"
                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBox x:Name="TxtPlayerName" Text="PixelMaster7" Height="44" Margin="0,0,0,24"/>

                            <!-- APPLE LIQUID EMERALD PLAY BUTTON -->
                            <Button x:Name="BtnPlay" Height="60" Cursor="Hand" Click="BtnPlay_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <!-- Liquid Emerald Glow Shadow -->
                                            <Border CornerRadius="20" Background="#00FF9D" Opacity="0.55"
                                                    Effect="{StaticResource EmeraldLiquidGlow}" Margin="2"/>

                                            <!-- Outer Specular Ring -->
                                            <Border CornerRadius="20" BorderThickness="1.5">
                                                <Border.BorderBrush>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#C0FFFFFF" Offset="0.0"/>
                                                        <GradientStop Color="#4000FF9D" Offset="1.0"/>
                                                    </LinearGradientBrush>
                                                </Border.BorderBrush>

                                                <!-- Button Body: Vibrant Liquid Gradient -->
                                                <Border CornerRadius="19" BorderThickness="0" ClipToBounds="True">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#00FFB2" Offset="0.0"/>
                                                            <GradientStop Color="#00B86B" Offset="1.0"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>

                                                    <Grid>
                                                        <!-- Top Specular Sheen (Liquid Glass Pill Highlight) -->
                                                        <Border VerticalAlignment="Top" Height="28" CornerRadius="19,19,0,0">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#55FFFFFF" Offset="0.0"/>
                                                                    <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>

                                                        <!-- Text Label with Soft Depth -->
                                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="PLAY" FontSize="26" FontWeight="Black"
                                                                       Foreground="#05331E" Margin="0,2,0,0" Opacity="0.35"/>
                                                            <TextBlock Text="PLAY" FontSize="26" FontWeight="Black"
                                                                       Foreground="#FFFFFF"/>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <ScaleTransform ScaleX="1.025" ScaleY="1.025" CenterX="150" CenterY="30"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <ScaleTransform ScaleX="0.975" ScaleY="0.975" CenterX="150" CenterY="30"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- TÚI ĐỒ (SKIN & MODEL) BUTTON -->
                            <Button x:Name="BtnOpenSkinShop" Content="🛒 TÚI ĐỒ (SKIN &amp; MODEL)" Height="40" Margin="0,14,0,0"
                                    Style="{StaticResource SecondaryButton}" Click="BtnOpenSkinShop_Click"
                                    FontSize="13" FontWeight="Bold"/>

                            <!-- COIN BALANCE (MAIN SCREEN) -->
                            <Border x:Name="BorderMainCoinBar" CornerRadius="12" Padding="14,6" HorizontalAlignment="Center" Margin="0,12,0,0"
                                    Cursor="Hand" PreviewMouseLeftButtonDown="CoinBar_MouseDown" ToolTip="Nhấn để mở Trung tâm đá cuội">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#1CFFFFFF"/>
                                        <Setter Property="BorderBrush" Value="#25FFFFFF"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#35FFFFFF"/>
                                                <Setter Property="BorderBrush" Value="#8000FF9D"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🪨" FontFamily="Segoe UI Emoji, Segoe UI Symbol" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="TxtMainCoins" Text="0" FontSize="13" FontWeight="Bold" Foreground="#00FF9D" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- DEBUG SERVER IP (Visible ONLY when launched with -debug arg) -->
                            <TextBlock x:Name="TxtDebugIp" Text="" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#8000FF9D" HorizontalAlignment="Center" Margin="0,10,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- 3. SKIN SHOP & YSM PANEL (Shopee Grid Style)  -->
                    <!-- ============================================== -->
                    <Grid x:Name="PanelSkinShop" Visibility="Collapsed" VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="TỦ ĐỒ &amp; CỬA HÀNG SKIN YSM" FontSize="15" FontWeight="Black" Foreground="#FFFFFF"/>
                                <TextBlock Text="Điểm danh mỗi ngày: +1,000 Đá Cuội • Chơi 5p: +100 Đá Cuội" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border CornerRadius="14" Padding="14,6"
                                        Cursor="Hand" PreviewMouseLeftButtonDown="CoinBar_MouseDown" ToolTip="Nhấn để mở Trung tâm đá cuội">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#25FFFFFF"/>
                                            <Setter Property="BorderBrush" Value="#35FFFFFF"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#40FFFFFF"/>
                                                    <Setter Property="BorderBrush" Value="#8000FF9D"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🪨" FontFamily="Segoe UI Emoji, Segoe UI Symbol" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="TxtShopCoins" Text="0" FontSize="14" FontWeight="Bold" Foreground="#00FF9D" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Search Box & Filter Tabs -->
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="TxtSkinSearch" Height="34" FontSize="12" HorizontalContentAlignment="Left"
                                     TextChanged="TxtSkinSearch_TextChanged"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnFilterAll" Content="Tất cả" Height="30" Margin="0,0,6,0"
                                        Style="{StaticResource SecondaryButton}" Click="BtnFilter_Click" Tag="all"/>
                                <Button x:Name="BtnFilterOwned" Content="Đã sở hữu" Height="30" Margin="0,0,6,0"
                                        Style="{StaticResource SecondaryButton}" Click="BtnFilter_Click" Tag="owned"/>
                                <Button x:Name="BtnFilterUnowned" Content="Chưa sở hữu" Height="30"
                                        Style="{StaticResource SecondaryButton}" Click="BtnFilter_Click" Tag="unowned"/>
                            </StackPanel>
                        </Grid>

                        <!-- Shopee 4-Column Product Grid -->
                        <Border Grid.Row="2" Background="#28000000" CornerRadius="16" BorderThickness="1" BorderBrush="#20FFFFFF" Padding="8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <WrapPanel x:Name="ContainerSkinCards" ItemWidth="214" HorizontalAlignment="Center"/>
                            </ScrollViewer>
                        </Border>

                        <!-- Footer -->
                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <Button Content="↩ Quay lại màn hình chính" Height="36" HorizontalAlignment="Stretch"
                                    Style="{StaticResource SecondaryButton}" Click="BtnCloseSkinShop_Click"
                                    FontSize="13" FontWeight="SemiBold"/>
                        </Grid>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- 4. TRUNG TÂM ĐÁ CUỘI (COBBLESTONE CENTER)     -->
                    <!-- ============================================== -->
                    <Grid x:Name="PanelCobbleCenter" Visibility="Collapsed" VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="TRUNG TÂM ĐÁ CUỘI" FontSize="16" FontWeight="Black" Foreground="#FFFFFF"/>
                                <TextBlock Text="Điểm danh nhận quà • Tiến trình thời gian chơi • Đổi mã Giftcode" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border Background="#25FFFFFF" CornerRadius="14" Padding="12,5" BorderBrush="#35FFFFFF" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🪨" FontFamily="Segoe UI Emoji, Segoe UI Symbol" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="TxtCenterCoins" Text="0" FontSize="14" FontWeight="Bold" Foreground="#00FF9D" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Scrollable Center Body -->
                        <Border Grid.Row="1" Background="#28000000" CornerRadius="16" BorderThickness="1" BorderBrush="#20FFFFFF" Padding="14,10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,6,0">
                                    <!-- 1. ĐIỂM DANH HÀNG NGÀY (7-DAY STREAK) -->
                                    <Border Background="#1C111E2E" CornerRadius="14" BorderBrush="#25FFFFFF" BorderThickness="1" Padding="14,12" Margin="0,0,0,12">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="📅" FontFamily="Segoe UI Emoji, Segoe UI Symbol" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="ĐIỂM DANH HÀNG NGÀY" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock x:Name="TxtStreakStatus" Text="Chuỗi điểm danh: 0/7 ngày" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="#38BDF8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- 7-Day Streak Grid -->
                                            <UniformGrid x:Name="GridStreakDays" Columns="7" Margin="0,0,0,12"/>

                                            <!-- Check-in Action Button -->
                                            <Button x:Name="BtnClaimDaily" Content="🎁 ĐIỂM DANH NGAY (+1,000 🪨)" Height="36"
                                                    Style="{StaticResource SecondaryButton}" Click="BtnClaimDaily_Click"
                                                    FontSize="12" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 2. TIẾN TRÌNH THỜI GIAN CHƠI -->
                                    <Border Background="#1C111E2E" CornerRadius="14" BorderBrush="#25FFFFFF" BorderThickness="1" Padding="14,12" Margin="0,0,0,12">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="⏱" FontFamily="Segoe UI Emoji, Segoe UI Symbol" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="TIẾN TRÌNH THỜI GIAN CHƠI" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock x:Name="TxtTotalPlayTime" Text="Tổng đã chơi: 0h 0m" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="#00FF9D" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Milestone 5 Mins -->
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="Cột mốc 5 phút (+100 🪨)" FontSize="11" Foreground="#CBD5E1"/>
                                                <TextBlock x:Name="TxtProgress5Min" Text="00:00 / 05:00" FontSize="11" FontWeight="SemiBold" Foreground="#00FF9D" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Border CornerRadius="4" Height="7" Background="#20FFFFFF" Margin="0,0,0,10" ClipToBounds="True">
                                                <ProgressBar x:Name="ProgressBar5Min" Height="7" Value="0" Maximum="300"
                                                             Background="Transparent" Foreground="#00FF9D" BorderThickness="0"/>
                                            </Border>

                                            <!-- Milestone 1 Hour -->
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="Cột mốc 1 giờ (+200 🪨 thưởng thêm)" FontSize="11" Foreground="#CBD5E1"/>
                                                <TextBlock x:Name="TxtProgress1Hour" Text="00:00 / 60:00" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Border CornerRadius="4" Height="7" Background="#20FFFFFF" Margin="0,0,0,4" ClipToBounds="True">
                                                <ProgressBar x:Name="ProgressBar1Hour" Height="7" Value="0" Maximum="3600"
                                                             Background="Transparent" Foreground="#38BDF8" BorderThickness="0"/>
                                            </Border>
                                            <TextBlock Text="* Giữ game Minecraft mở để tự động tích lũy thời gian và nhận Đá Cuội." FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 3. NHẬP MÃ GIFTCODE -->
                                    <Border Background="#1C111E2E" CornerRadius="14" BorderBrush="#25FFFFFF" BorderThickness="1" Padding="14,12">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="🎫" FontFamily="Segoe UI Emoji, Segoe UI Symbol" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="ĐỔI MÃ GIFTCODE" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TxtGiftcodeInput" Height="36" FontSize="12" Margin="0,0,8,0"
                                                         HorizontalContentAlignment="Left" Padding="10,0"/>
                                                <Button Grid.Column="1" x:Name="BtnRedeemGiftcode" Content="ĐỔI MÃ" Height="36"
                                                        Style="{StaticResource SecondaryButton}" Click="BtnRedeemGiftcode_Click"
                                                        FontSize="12" FontWeight="Bold"/>
                                            </Grid>

                                            <!-- Result alert banner -->
                                            <Border x:Name="BorderGiftcodeResult" CornerRadius="8" Padding="10,8" Visibility="Collapsed" Margin="0,4,0,0">
                                                <TextBlock x:Name="TxtGiftcodeResult" Text="" FontSize="11" TextWrapping="Wrap"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Footer -->
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Button Content="↩ Quay lại" Height="36" HorizontalAlignment="Stretch"
                                    Style="{StaticResource SecondaryButton}" Click="BtnCloseCobbleCenter_Click"
                                    FontSize="13" FontWeight="SemiBold"/>
                        </Grid>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- 2. LOADING & LOG PANEL (After pressing PLAY)  -->
                    <!-- ============================================== -->
                    <Grid x:Name="PanelLoading" Visibility="Collapsed" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center" Width="430">
                            <!-- Status & Progress Percentage -->
                            <Grid Margin="4,0,4,8">
                                <TextBlock x:Name="TxtStatus" Text="Đang khởi chạy Cobblemon..." FontSize="13"
                                           FontWeight="SemiBold" Foreground="#E2E8F0"/>
                                <TextBlock x:Name="TxtProgressPercent" Text="0%" FontSize="13" FontWeight="Bold"
                                           Foreground="#00FF9D" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Apple Sleek Liquid Loading Bar -->
                            <Border CornerRadius="5" Height="8" Background="#20FFFFFF" Margin="0,0,0,16" ClipToBounds="True">
                                <ProgressBar x:Name="ProgressBarLoading" Height="8" Value="0" Maximum="100"
                                             Background="Transparent" Foreground="#00FF9D" BorderThickness="0"/>
                            </Border>

                            <!-- Under Loading Bar: Translucent Frosted Glass Log Box -->
                            <Border Height="155" CornerRadius="14" Background="#35000000" BorderThickness="1" Padding="10">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#25FFFFFF" Offset="0.0"/>
                                        <GradientStop Color="#0AFFFFFF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <ScrollViewer x:Name="ScrollLogs" VerticalScrollBarVisibility="Auto">
                                    <TextBox x:Name="TxtLogs" Background="Transparent" Foreground="#85FFBD"
                                             BorderThickness="0" FontFamily="Consolas, Courier New" FontSize="11"
                                             IsReadOnly="True" TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- 4. MODERN HUD GAMING UPDATE SCREEN (v2.0.0)    -->
                    <!-- ============================================== -->
                    <Grid x:Name="PanelUpdateHUD" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Width="520">
                        <Border Background="#E60F172A" BorderBrush="#3500FF9D" BorderThickness="1.5" CornerRadius="20" Padding="24">
                            <StackPanel>
                                <!-- Header: Badge & Title -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <Border Background="#2000FF9D" BorderBrush="#00FF9D" BorderThickness="1" CornerRadius="12" Padding="8,3" Margin="0,0,8,0">
                                        <TextBlock Text="AUTO-UPDATE" FontSize="11" FontWeight="Black" Foreground="#00FF9D"/>
                                    </Border>
                                    <TextBlock x:Name="TxtUpdateHeader" Text="Phát hiện bản cập nhật mới v2.0.0" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Changelog Box -->
                                <Border Height="110" CornerRadius="12" Background="#20000000" BorderBrush="#15FFFFFF" BorderThickness="1" Padding="12" Margin="0,0,0,16">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="ContainerChangelog">
                                            <TextBlock Text="✨ ĐIỂM MỚI TRÊN PHIÊN BẢN 2.0.0:" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,6"/>
                                            <TextBlock Text="• Nâng cấp công nghệ Atomic In-Place Swap (Cập nhật tức thì, không giật lag)." FontSize="11" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                            <TextBlock Text="• Tích hợp xác thực mã băm SHA-256 chống lỗi file đường truyền." FontSize="11" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                            <TextBlock Text="• Giao diện HUD tải cập nhật cao cấp theo thời gian thực (MB/s)." FontSize="11" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>

                                <!-- Progress Details & Speed -->
                                <Grid Margin="2,0,2,6">
                                    <TextBlock x:Name="TxtUpdateStatus" Text="Đang tải gói cập nhật..." FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock x:Name="TxtUpdateSpeed" Text="-- MB/s" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="TxtUpdatePercent" Text="0%" FontSize="13" FontWeight="Black" Foreground="#00FF9D"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Neon Gradient Liquid Progress Bar -->
                                <Border CornerRadius="6" Height="10" Background="#25FFFFFF" Margin="0,0,0,10" ClipToBounds="True">
                                    <ProgressBar x:Name="ProgressBarUpdate" Height="10" Value="0" Maximum="100"
                                                 Background="Transparent" Foreground="#00FF9D" BorderThickness="0"/>
                                </Border>

                                <!-- Footer sub-status -->
                                <TextBlock x:Name="TxtUpdateSubStatus" Text="Hệ thống sẽ tự động khởi động lại ngay sau khi hoàn tất..."
                                           FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Launcher Version Display (Bottom Right) -->
                <TextBlock x:Name="TxtLauncherVersion" Text="v2.0.1" FontSize="11" FontWeight="SemiBold"
                           Foreground="#40FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,10"/>
            </Grid>
        </Border>

        <!-- TOP MIDDLE: Emoji Cobblestone & Half Doraemon ("Đá Cuội Mon") -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Height="80" Cursor="Hand"
                MouseLeftButtonDown="Window_MouseDown">
            <Image x:Name="ImgMascot" Height="76" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>
    </Grid>
</Window>
